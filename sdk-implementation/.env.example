# Copy to .env.local and fill in. Required for GO_MODE=live; ignored in mock
# mode. Next.js loads .env.local automatically — no sourcing step needed.
#
# .env.local is gitignored. Never commit real values — not here, not in
# lib/config/markets/*.ts, not in a test or a scratch script.

# From the Account management portal, or whoever administers the tenant.
GBG_CLIENT_ID=
GBG_CLIENT_SECRET=

# Password grant only (the nonprod fabric tenants). Leave blank for the public
# platform, which uses client_credentials. Note the SDK cannot reach a
# Keycloak token endpoint, so the password grant does not work in this
# implementation — see README, "Known gaps" (i).
GBG_USERNAME=
GBG_PASSWORD=
